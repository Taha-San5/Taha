# Copy to .env and fill in.

# SQLite for local dev; use a postgresql:// URL in production
# (also switch `provider` in prisma/schema.prisma).
DATABASE_URL="file:./dev.db"

# Secret used to sign session JWTs (min 32 chars)
AUTH_SECRET=""

# Key used to encrypt stored integration credentials (min 32 chars)
ENCRYPTION_KEY=""

# Optional platform LLM key. Leave blank to use the built-in simulated model.
OPENAI_API_KEY=""
OPENAI_BASE_URL="https://api.openai.com/v1"

# Optional. Leave unset and the app derives its URL from the request, so a
# custom domain works with no rebuild. Set it only to force a specific URL.
# APP_URL="https://wasl.example.com"

# Google sign-in (optional). When both are set, a "Continue with Google" button
# appears on the login and signup pages; when absent it is hidden entirely.
# Create credentials at https://console.cloud.google.com/apis/credentials and add
# <your-url>/api/auth/google/callback as an Authorized redirect URI.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
